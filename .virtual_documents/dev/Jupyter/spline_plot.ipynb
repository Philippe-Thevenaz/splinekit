





# Load the required libraries
import ipywidgets as widgets
import matplotlib.pyplot as plt
import numpy as np

import splinekit as sk # This library

# Setup
max_degree = 3 # Maximal spline degree
max_samples = 10 # Maximal support

# Initial random periodic cubic spline
s0 = sk.PeriodicSpline1D.from_spline_coeff(np.random.standard_normal(6), degree = 3)

#widget controls
linestyle_options = [
    ("'-'  solid", 0),
    ("'--' dashed", 1),
    ("'-.' mixed", 2),
    ("':'  dotted", 3)
]
linestyle_codes = [
    "-",
    "--",
    "-.",
    ":"
]
color_options = [
    ("'C0' default blue", 0),
    ("'C1' default orange", 1),
    ("'C2' default green", 2),
    ("'C3' default red", 3),
    ("'C4' default purple", 4),
    ("'C5' default brown", 5),
    ("'C6' default pink", 6),
    ("'C7' default gray", 7),
    ("'C8' default olive", 8),
    ("'C9' default cyan", 9),
    ("'b'  named blue", 10),
    ("'g'  named green", 11),
    ("'r'  named red", 12),
    ("'c'  named cyan", 13),
    ("'m'  named magenta", 14),
    ("'y'  named yellow", 15),
    ("'k'  named black", 16),
    ("'w'  named white", 17)
]
color_codes = [
    "C0",
    "C1",
    "C2",
    "C3",
    "C4",
    "C5",
    "C6",
    "C7",
    "C8",
    "C9",
    "b",
    "g",
    "r",
    "c",
    "m",
    "y",
    "k",
    "w"
]
marker_options = [
    ("' ' ---NONE---", 0),
    ("'.' point", 1),
    ("',' pixel", 2),
    ("'o' circle", 3),
    ("'v' triangle down", 4),
    ("'^' triangle up", 5),
    ("'<' triangle left", 6),
    ("'>' triangle right", 7),
    ("'1' tri_down", 8),
    ("'2' tri_up", 9),
    ("'3' tri_left", 10),
    ("'4' tri_right", 11),
    ("'8' octagon", 12),
    ("'s' square", 13),
    ("'p' pentagon", 14),
    ("'P' plus (filled)", 15),
    ("'*' star", 16),
    ("'h' hexagon1", 17),
    ("'H' hexagon2", 18),
    ("'+' plus", 19),
    ("'x' cross", 20),
    ("'X' cross (filled)", 21),
    ("'D' diamond", 22),
    ("'d' thin diamond", 23),
    ("'|' vline", 24),
    ("'_' hline", 25)
]
marker_codes = [
    " ",
    ".",
    ",",
    "o",
    "v",
    "^",
    "<",
    ">",
    "1",
    "2",
    "3",
    "4",
    "8",
    "s",
    "p",
    "P",
    "*",
    "h",
    "H",
    "+",
    "x",
    "X",
    "D",
    "d",
    "|",
    "_"
]
plotdomain_widget = widgets.FloatRangeSlider(
    value = [-1.0, 7.0],
    min = -1.0 * max_samples,
    max = 2.0 * max_samples,
    step = 0.25,
    description = "domain:",
    readout_format = ".2f"
)
plotrange_widget = widgets.FloatRangeSlider(
    value = [-2.0, 2.0],
    min = -5.0,
    max = 5.0,
    step = 0.2,
    description = "range:",
    readout_format = ".1f"
)
curve_fmt_linestyle_widget = widgets.Dropdown(
    options = linestyle_options,
    value = 0,
    description = "curve:"
)
curve_fmt_linecolor_widget = widgets.Dropdown(
    options = color_options,
    value = 0,
    description = "curve:"
)
curve_lw_widget = widgets.FloatSlider(
    value = 1.0,
    min = 0.1,
    max = 3.0,
    step = 0.1,
    description = "curve:",
    readout_format = ".1f"
)
curve_markerfmt_style_widget = widgets.Dropdown(
    options = marker_options,
    value = 3,
    description = "curve mrkr:"
)
curve_markerfmt_color_widget = widgets.Dropdown(
    options = color_options,
    value = 0,
    description = "curve mrkr:"
)

# Plot
def update_plot (
    default_plotdomain = True,
    default_plotrange = True,
    default_curve_fmt = True,
    default_curve_lw = True,
    default_curve_markerfmt = True,
    degree = 3,
    samples = 5,
    plotdomain = [-1.0, 7.0],
    plotrange = [-2.0, 2.0],
    plotpoints = 51,
    curve_fmt_linestyle = 0,
    curve_fmt_linecolor = 0,
    curve_lw = 1.0,
    curve_markerfmt_style = 3,
    curve_markerfmt_color = 0
):
    global s0

    # Update of the spline
    f = s0.get_samples(0, support_length = s0.period)
    if s0.period < samples:
        f = np.append(f, np.random.standard_normal(samples - len(f)))
    else:
        f = f[ : samples]
    s0 = sk.PeriodicSpline1D.from_samples(f, degree = degree)

    # plotdomain
    plotdomain_interval = sk.interval.Closed(plotdomain)
    if default_plotdomain:
        plotdomain_interval = sk.interval.RR()
    plotdomain_widget.disabled = default_plotdomain

    # plotrange
    plotrange_interval = sk.interval.Closed(plotrange)
    if default_plotrange:
        plotrange_interval = sk.interval.RR()
    plotrange_widget.disabled = default_plotrange

    # curve_fmt
    curve_fmt_linestyle_string = linestyle_codes[curve_fmt_linestyle]
    if default_curve_fmt:
        curve_fmt_linestyle_string = "-"
    curve_fmt_linestyle_widget.disabled = default_curve_fmt
    curve_fmt_linecolor_string = color_codes[curve_fmt_linecolor]
    if default_curve_fmt:
        curve_fmt_linecolor_string = "C0"
    curve_fmt_linecolor_widget.disabled = default_curve_fmt

    # curve_lw
    curve_linewidth = curve_lw
    if default_curve_lw:
        curve_linewidth = 1.0
    curve_lw_widget.disabled = default_curve_lw

    # curve_markerfmt
    curve_markerfmt_style_string = marker_codes[curve_markerfmt_style]
    if default_curve_markerfmt:
        curve_markerfmt_style_string = "o"
    curve_markerfmt_style_widget.disabled = default_curve_markerfmt
    curve_markerfmt_color_string = ""
    if 0 != curve_markerfmt_style:
        curve_markerfmt_color_string = color_codes[curve_markerfmt_color]
    if default_curve_markerfmt:
        curve_markerfmt_color_string = "C0"
    curve_markerfmt_color_widget.disabled = default_curve_markerfmt

    # Plot of the spline
    subplot = plt.subplots()
    s0.plot(
        subplot,
        plotdomain = plotdomain_interval,
        plotrange = plotrange_interval,
        plotpoints = plotpoints,
        curve_fmt = curve_fmt_linestyle_string + curve_fmt_linecolor_string,
        curve_lw = curve_linewidth,
        curve_markerfmt = curve_markerfmt_style_string + curve_markerfmt_color_string,
        curvestem_linefmt = "None",
        knot_marker = "",
        periodbound_markerfmt = "",
        periodboundstem_linefmt = "None"
    )
    plt.show()

# interactive
widgets.interactive(
    update_plot,
    default_plotdomain = widgets.Checkbox(
        value = True,
        description = "plotdomain = sk.interval.RR()"
    ),
    default_plotrange = widgets.Checkbox(
        value = True,
        description = "plotrange = sk.interval.RR()"
    ),
    default_curve_fmt = widgets.Checkbox(
        value = True,
        description = "curve_fmt = '-C0'"
    ),
    default_curve_lw = widgets.Checkbox(
        value = True,
        description = "curve_lw = 1.0"
    ),
    default_curve_markerfmt = widgets.Checkbox(
        value = True,
        description = "curve_markerfmt = 'oC0'"
    ),
    degree = (0, max_degree),
    samples = (1, max_samples),
    plotdomain = plotdomain_widget,
    plotrange = plotrange_widget,
    plotpoints = widgets.IntSlider(
        value = 51,
        min = 2,
        max = 101,
        step = 1,
        description = "plotpoints"
    ),
    curve_fmt_linestyle = curve_fmt_linestyle_widget,
    curve_fmt_linecolor = curve_fmt_linecolor_widget,
    curve_lw = curve_lw_widget,
    curve_markerfmt_style = curve_markerfmt_style_widget,
    curve_markerfmt_color = curve_markerfmt_color_widget
)

























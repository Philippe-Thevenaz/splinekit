























# Load the required libraries
import ipywidgets as widgets
import matplotlib.pyplot as plt
import numpy as np

import splinekit as sk # This library

# Setup
max_period = 15 # Maximal period
max_degree = 9 # Maximal spline degree
max_delay = 3.0 # Maximal absolute delay

# Persistent spline
f = sk.PeriodicSpline1D()

# Initialize the generator of random numbers
rng = np.random.default_rng()

# Plot
def update_plot (
    period = 9,
    degree = 2,
    bounding_degree = 1,
    delay = 0.0
):
    global f # Spline

    # Update of the degree
    if f.degree != degree:
        f = f.projected(degree = degree, delay = delay)
    # Update of the period
    c = f.spline_coeff
    if f.period < period:
        c = np.append(c, np.random.standard_normal(period - f.period))
    else:
        c = c[ : period]
    # Spline being bounded
    f = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree, delay = delay)
    # Lowerbound
    lb = f.lower_bound(degree = bounding_degree)
    # Upperbound
    ub = f.upper_bound(degree = bounding_degree)
    # Plot the splines
    (fig, ax) = plt.subplots()
    f.plot((fig, ax), plotpoints = 301, curve_fmt = "-k")
    lb.plot((fig, ax), plotpoints = 301, curve_fmt = "-C5")
    ub.plot((fig, ax), plotpoints = 301, curve_fmt = "-C0")

    # Show the plot
    plt.show()

widgets.interactive(
    update_plot,
    period = (1, max_period),
    degree = (0, max_degree),
    bounding_degree = (0, max_degree),
    delay = (-max_delay, max_delay)
)




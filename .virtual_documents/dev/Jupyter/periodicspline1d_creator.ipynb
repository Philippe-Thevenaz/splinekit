











# Load the required libraries.
import ipywidgets as widgets
import matplotlib.pyplot as plt
import numpy as np

import splinekit as sk # This library

# Setup
max_samples = 15 # Maximal support of the data samples
max_degree = 5 # Maximal spline degree
max_delay = 3.0 # Maximal absolute delay

# Plot
def update_plot (
    period = 6,
    degree = 3,
    delay = 0.0,
    regularized = False
):
    # Initialize the generator of random numbers
    rng = np.random.default_rng()
    # Random samples
    samples = rng.standard_normal(period)
    # Spline from samples
    f = sk.PeriodicSpline1D.from_samples(
        samples,
        degree = degree,
        delay = delay, 
        regularized = regularized
    )
    # Undelayed linear interpolation of the samples
    f1 = sk.PeriodicSpline1D.from_samples(samples, degree = 1)
    # Plot
    (fig, ax) = plt.subplots()
    # Linear interpolation in thin gray
    f1.plot(
        (fig, ax),
        line_fmt = "-C7",
        line_width = 0.5,
        plotpoints = 301,
        knot_marker = "None"
    )
    # Spline
    fn.plot((fig, ax), plotpoints = 301)
    plt.show()

# widgets.interactive(
widgets.interact(
    update_plot,
    period = (1, max_samples),
    degree = (0, max_degree),
    delay = (max_delay, max_delay),
    regularized = widgets.Checkbox(value = False, description = 'Regularized')
)





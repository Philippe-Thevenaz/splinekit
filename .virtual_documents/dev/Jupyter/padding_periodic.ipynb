


# Load the required libraries.
from IPython.display import clear_output
from IPython.display import display
import ipywidgets as widgets
import matplotlib.pyplot as plt
import numpy as np

import splinekit as sk # This library

# Setup
max_degree = 5 # Maximal spline degree
degree = 3
max_data_samples = 8 # Maximal support of the observed data
data_samples = 6
padding = 0
output = widgets.Output()
t = 0

# Plot
def update_plot():
    global data_samples
    global degree
    global padding
    global t
    t = t + 1
    with output:
        clear_output()
        print(t, padding, data_samples, degree)
    s = sk.PeriodicSpline1D()
    c0 = np.random.standard_normal(data_samples) # Random coefficients
    if 0 == padding: # Periodic
        s = sk.PeriodicSpline1D.from_spline_coeff(c0, degree = degree)
    elif 1 == padding: # Narrow Mirror
        c = np.zeros(2 * data_samples - 2, dtype = float)
        for k in range(len(c)):
            c[k] = sk.pad_n(c0, at = k)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree)
    elif 2 == padding: # Wide Mirror
        c = np.zeros(2 * data_samples, dtype = float)
        for k in range(len(c)):
            c[k] = sk.pad_w(c0, at = k)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree)
    elif 3 == padding: # Anti-Mirror
        c = np.zeros(5 * (2 * data_samples - 2) + 2 * (degree + 1), dtype = float)
        delay = 4 - 4 * data_samples - degree - 1
        for k in range(len(c)):
            c[k] = sk.pad_a(c0, at = k - delay)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree, delay = delay)
    elif 4 == padding: # Nega-Periodic
        c = np.zeros(2 * data_samples, dtype = float)
        for k in range(len(c)):
            c[k] = sk.pad_np(c0, at = k)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree)
    elif 5 == padding: # Nega-Narrow Mirror
        c = np.zeros(2 * data_samples + 2, dtype = float)
        for k in range(len(c)):
            c[k] = sk.pad_nn(c0, at = k)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree)
    elif 6 == padding: # Nega-Wide Mirror
        c = np.zeros(2 * data_samples, dtype = float)
        for k in range(len(c)):
            c[k] = sk.pad_nw(c0, at = k)
        s = sk.PeriodicSpline1D.from_spline_coeff(c, degree = degree)
    with output:
        print(t, " Will do plot of ", s.__repr__())
    (fig, ax) = plt.subplots()
    s.plot((fig, ax), plotpoints = 301)
    with output:
        print(t, " Will show plot")
    plt.show()
    with output:
        print(t, " Did show plot")

# Paddings
padding_buttons = widgets.RadioButtons(
    options = [
        ("Periodic", 0),
        ("Narrow Mirror", 1),
        ("Wide Mirror", 2),
        ("Anti-Mirror", 3),
        ("Nega-Periodic", 4),
        ("Nega-Narrow Mirror", 5),
        ("Nega-Wide Mirror", 6)
    ],
    value = padding,
    description = "padding",
    disabled = False
)
def on_padding_buttons_changed(change):
    global padding
    padding = change["new"]
    update_plot()
padding_buttons.observe(on_padding_buttons_changed, names = "value")

# Allow for the selection of the number of data samples
data_samples_slider = widgets.IntSlider(min = 1, max = max_data_samples, value = data_samples)
def on_data_samples_changed(change):
    global data_samples
    data_samples = change["new"]
    update_plot()
data_samples_slider.observe(on_data_samples_changed, names = "value")

# Allow for the selection of the degree
degree_slider = widgets.IntSlider(min = 1, max = max_degree, value = degree)
def on_degree_changed(change):
    global degree
    degree = change["new"]
    update_plot()
degree_slider.observe(on_degree_changed, names = "value")

# Layout of the interactive panel
box = widgets.VBox([
    widgets.HBox([padding_buttons]),
    widgets.HBox([widgets.Label("data samples"), data_samples_slider]),
    widgets.HBox([widgets.Label("degree"), degree_slider])
])
display(box, output)
widgets.interactive(update_plot)











# Load the required libraries.
#import math
import matplotlib.pyplot as plt
import numpy as np

import splinekit as sk # This library

# Setup
highest_degree = 9
highest_scale = 4
pts = 200 + 1

# Define the plot function
def m_scale_plot (
    degree = 3,
    scale = 2
):
    # Nominal support
    supp = int(sk.b_spline_support(degree).diameter)
    # Setup of the plot
    plt.xlim(-supp / 2, supp / 2)
    plt.ylim(-0.05, 1.05)
    ax = plt.gca()
    ax.spines.right.set_visible(False)
    ax.spines.top.set_visible(False)
    # Location of the samples
    abscissa = np.array(
        [-supp / 2 + supp * k / (pts - 1) for k in range(pts)],
        dtype = float
    )
    # Nominal B-spline
    nominal_bspline_data = np.array(
        [sk.b_spline(x, degree) for x in abscissa],
        dtype = float
    )
    plt.plot(
        abscissa,
        nominal_bspline_data,
        "-C0"
    )
    plt.show()

# Interact with the degree and the scale
interactive(m_scale_plot, degree = (0, highest_degree), scale = (1, highest_scale))




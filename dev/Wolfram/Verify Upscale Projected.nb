Cell[BoxData[
 RowBox[{
  RowBox[{"PythonUpscaleProjected", "[", 
   RowBox[{"f0_", ",", "M_", ",", "n_", ",", "\[Delta]x_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "K", ",", "n0", ",", "p0", ",", "h", ",", "h0", ",", "x0", ",", "m0", ",",
       "c", ",", "k", ",", "q", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"K", "=", 
      RowBox[{"PeriodP\[Beta]", "[", "f0", "]"}]}], ";", 
     RowBox[{"n0", "=", 
      RowBox[{"DegreeP\[Beta]", "[", "f0", "]"}]}], ";", 
     RowBox[{"p0", "=", 
      RowBox[{"M", " ", "K"}]}], ";", 
     RowBox[{"h", "=", 
      RowBox[{"H\[Beta]", "[", 
       RowBox[{"M", ",", "n0"}], "]"}]}], ";", 
     RowBox[{"h0", "=", 
      RowBox[{"Length", "[", "h", "]"}]}], ";", 
     RowBox[{"x0", "=", 
      RowBox[{"\[Delta]x", "-", 
       RowBox[{"M", " ", 
        RowBox[{"DelayP\[Beta]", "[", "f0", "]"}]}], "+", 
       FractionBox[
        RowBox[{"h0", "-", "1"}], "2"]}]}], ";", 
     RowBox[{"m0", "=", 
      RowBox[{"n0", "+", "n", "+", "1"}]}], ";", 
     RowBox[{"c", "=", 
      RowBox[{"f0", "[", "\"\<c\>\"", "]"}]}], ";", 
     RowBox[{"c", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "n0"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"q", "=", 
            RowBox[{"\[LeftCeiling]", 
             FractionBox[
              RowBox[{"k", "-", "h0", "+", "1"}], "M"], "\[RightCeiling]"}]}], 
           RowBox[{"\[LeftFloor]", 
            FractionBox["k", "M"], "\[RightFloor]"}]], 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"[", 
             RowBox[{"k", "-", 
              RowBox[{"M", " ", "q"}], "+", 
              RowBox[{"(", "1", ")"}]}], "]"}], "]"}], 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"q", ",", "K"}], "]"}], "+", 
              RowBox[{"(", "1", ")"}]}], "]"}], "]"}]}]}]}], ",", 

            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"k", "-", "q"}], ",", "p0"}], "]"}], "+", 
            RowBox[{"(", "1", ")"}]}], "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"p0", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",

        RowBox[{
         RowBox[{"2", "n"}], "+", "1"}]}], "]"}]}], ";", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"q", "=", 
          RowBox[{"\[LeftCeiling]", 
           RowBox[{
            RowBox[{"-", "x0"}], "-", 
            FractionBox[
             RowBox[{"m0", "+", "1"}], "2"]}], "\[RightCeiling]"}]}], 
         RowBox[{"\[LeftFloor]", 
          RowBox[{
           RowBox[{"-", "x0"}], "+", 
           FractionBox[
            RowBox[{"m0", "+", "1"}], "2"]}], "\[RightFloor]"}]], 
        RowBox[{
         RowBox[{"d\[Beta]", "[", 
          RowBox[{
           RowBox[{"q", "+", "x0"}], ",", "m0", ",", "0"}], "]"}], 

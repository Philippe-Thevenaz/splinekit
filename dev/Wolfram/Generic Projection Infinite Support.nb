     RowBox[{"K", "=", 
      RowBox[{"Length", "[", "c", "]"}]}], ";", 
     RowBox[{"periodicSplineFromSplineCoeffArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{"s", "[", "degree", "]"}]}], ";", 

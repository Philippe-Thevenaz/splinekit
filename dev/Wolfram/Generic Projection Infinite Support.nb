              RowBox[{"(", 
               RowBox[{"m", "+", "1"}], ")"}], "/", "2"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"m", "+", "n", "+", "2"}], ")"}], "/", "2"}]}], 
           "\[RightFloor]"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"m", "=", 
  RowBox[{"RandomInteger", "[", 
   RowBox[{"{", 
    RowBox[{"0", ",", "5"}], "}"}], "]"}]}], "\[IndentingNewLine]", 

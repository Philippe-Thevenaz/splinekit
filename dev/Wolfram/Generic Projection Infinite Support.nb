Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P\[Beta]UpscaledProjected", "[", 
    RowBox[{
     RowBox[{"s_", "/;", 
      RowBox[{"P\[Beta]Q", "[", "s", "]"}]}], ",", 
     RowBox[{"M_Integer", "?", "Positive"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n_Integer", "?", "NonNegative"}], ",", "\[CapitalDelta]x_"}], 
      "}"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"s", "[", "\"\<n\>\"", "]"}]}], ",", 
       RowBox[{"\[Delta]x", "=", 
        RowBox[{"s", "[", "\"\<\[CapitalDelta]x\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"1", "==", "M"}], ",", 
       RowBox[{"P\[Beta]Projected", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "\[CapitalDelta]x"}], "}"}]}], "]"}], ",", 
       RowBox[{"P\[Beta]FromCoeff\[Beta]", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"M", "^", 
           RowBox[{"-", "m"}]}], " ", 
          RowBox[{"ListConvolve", "[", 
           RowBox[{
            RowBox[{"H\[Beta]", "[", 
             RowBox[{"M", ",", "m"}], "]"}], ",", 
            RowBox[{"ListConvolve", "[", 
             RowBox[{
              RowBox[{"Array", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Beta]", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"m", "+", "n", "+", "1"}]}], "]"}], "&"}], ",", 
                RowBox[{"m", "+", "n", "+", "2"}], ",", 
                RowBox[{"\[CapitalDelta]x", "-", 
                 RowBox[{"M", " ", "\[Delta]x"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"M", "-", "1"}], ")"}], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"m", "+", "1"}], ")"}], "/", "2"}]}], "-", 
                 RowBox[{"\[LeftFloor]", 
                  RowBox[{"\[CapitalDelta]x", "-", 
                   RowBox[{"M", " ", "\[Delta]x"}], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"M", "-", "1"}], ")"}], 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"m", "+", "1"}], ")"}], "/", "2"}]}], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"m", "+", "n", "+", "2"}], ")"}], "/", "2"}]}], 
                  "\[RightFloor]"}]}]}], "]"}], ",", 
              RowBox[{"PeriodicSamplesToCoeff\[Beta]", "[", 
               RowBox[{
                RowBox[{"Upsample", "[", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<c\>\"", "]"}], ",", "M", ",", 
                  RowBox[{"0", "+", 
                   RowBox[{"(", "1", ")"}]}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{"2", "n"}], "+", "1"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ",", "n", ",", 
         RowBox[{"\[CapitalDelta]x", "-", 
          RowBox[{"\[LeftFloor]", 
           RowBox[{"\[CapitalDelta]x", "-", 
            RowBox[{"M", " ", "\[Delta]x"}], "+", 
            RowBox[{
             RowBox[{"(", 

Cell[BoxData[
 RowBox[{
  RowBox[{"splineProject", "[", 
   RowBox[{"s_", ",", "\[CapitalDelta]x_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "\[Delta]x", ",", "\[CapitalGamma]"}], "}"}], ",", 
    RowBox[{"splineFromCoefficients", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"s", "[", "degree", "]"}]}], ";", 
       RowBox[{"\[Delta]x", "=", 
        RowBox[{"s", "[", "delay", "]"}]}], ";", 
       RowBox[{"\[CapitalGamma]", "=", 
        RowBox[{"periodicCoefficient", "[", 
         RowBox[{
          RowBox[{"s", "[", "splineCoefficient", "]"}], ",", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}]}], "]"}]}], ";", 
       RowBox[{"\[CapitalGamma]", "=", 
        RowBox[{"ListConvolve", "[", 
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Beta]", "[", 
              RowBox[{"#", ",", 
               RowBox[{"m", "+", "n", "+", "1"}]}], "]"}], "&"}], ",", 
            RowBox[{"m", "+", "n", "+", "2"}], ",", 
            RowBox[{"\[CapitalDelta]x", "-", "\[Delta]x", "-", 
             RowBox[{"\[LeftFloor]", 
              RowBox[{"\[CapitalDelta]x", "-", "\[Delta]x", "+", 
               FractionBox[
                RowBox[{"m", "+", "n", "+", "2"}], "2"]}], 
              "\[RightFloor]"}]}]}], "]"}], ",", "\[CapitalGamma]", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"RotateLeft", "[", 
        RowBox[{"\[CapitalGamma]", ",", 
         RowBox[{"\[LeftFloor]", 
          RowBox[{"\[CapitalDelta]x", "-", "\[Delta]x", "+", 
           FractionBox[
            RowBox[{"m", "+", "n", "+", "2"}], "2"]}], "\[RightFloor]"}]}], 
        "]"}]}], ",", "\[CapitalDelta]x", ",", "n"}], "]"}]}], 
   "]"}]}]], "Input",

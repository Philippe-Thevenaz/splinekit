       RowBox[{"1", "==", "M"}], ",", 
       RowBox[{"Return", "[", "s", "]"}]}], "]"}], ";", 
     RowBox[{"c", "=", 
      RowBox[{"s", "[", "splineCoefficients", "]"}]}], ";", 
     RowBox[{"m", "=", 
      RowBox[{"s", "[", "degree", "]"}]}], ";", 
     RowBox[{"\[Delta]x", "=", 
      RowBox[{"s", "[", "delay", "]"}]}], ";", 
     RowBox[{"K", "=", 
      RowBox[{"Length", "[", "c", "]"}]}], ";", 
     RowBox[{"\[CapitalGamma]", "=", 
      RowBox[{"Upsample", "[", 
       RowBox[{"c", ",", "M"}], "]"}]}], ";", 
     RowBox[{"\[CapitalGamma]", "=", 
      RowBox[{
       SuperscriptBox["M", 
        RowBox[{"-", "m"}]], 
       RowBox[{"ListConvolve", "[", 
        RowBox[{
         RowBox[{"h\[Beta]", "[", 
          RowBox[{"M", ",", "m"}], "]"}], ",", "\[CapitalGamma]", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
     RowBox[{"\[CapitalGamma]", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{"\[CapitalGamma]", ",", 
        RowBox[{"m", "+", "1"}]}], "]"}]}], ";", 
     RowBox[{"splineFromCoefficients", "[", 
      RowBox[{"\[CapitalGamma]", ",", 
       RowBox[{
        RowBox[{"M", " ", "\[Delta]x"}], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"M", "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}]}], "2"], "-", 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]}], ",", "m"}], "]"}]}]}], 
   "]"}]}]], "Input",
